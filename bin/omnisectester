#!/usr/bin/env node

#!/usr/bin/env node

/**
 * OmniSec Tester CLI
 * Nation-state grade security testing framework
 * Version: 2.0.0
 */

const { program } = require('commander');
const { initLogger } = require('../src/cli/helpers/logger');
const EngageCommand = require('../src/cli/commands/engage');
const ScanCommand = require('../src/cli/commands/scan');
const ThreatModelCommand = require('../src/cli/commands/threat-model');
const RedTeamCommand = require('../src/cli/commands/redteam');
const ReportCommand = require('../src/cli/commands/report');
const SbomCommand = require('../src/cli/commands/sbom');
const ContinuousCommand = require('../src/cli/commands/continuous');
const ListCommand = require('../src/cli/commands/list');
const VerifyCommand = require('../src/cli/commands/verify');
const SeverityCommand = require('../src/cli/commands/severity');

// Initialize logger
const logger = initLogger();

// Display banner
console.log(`
\x1b[36m╔══════════════════════════════════════════════════════════════╗\x1b[0m
\x1b[36m║\x1b[0m  \x1b[1m\x1b[31m██████╗██╗   ██╗██████╗ ███████╗██████╗\x1b[0m                  \x1b[36m║\x1b[0m
\x1b[36m║\x1b[0m  \x1b[1m\x1b[31m██╔══██╗██║   ██║██╔══██╗██╔════╝██╔══██╗\x1b[0m                 \x1b[36m║\x1b[0m
\x1b[36m║\x1b[0m  \x1b[1m\x1b[31m██████╔╝██║   ██║██████╔╝█████╗  ██████╔╝\x1b[0m                 \x1b[36m║\x1b[0m
\x1b[36m║\x1b[0m  \x1b[1m\x1b[31m██╔══██╗██║   ██║██╔══██╗██╔══╝  ██╔══██╗\x1b[0m                 \x1b[36m║\x1b[0m
\x1b[36m║\x1b[0m  \x1b[1m\x1b[31m██████╔╝╚██████╔╝██████╔╝███████╗██║  ██║\x1b[0m                 \x1b[36m║\x1b[0m
\x1b[36m║\x1b[0m  \x1b[1m\x1b[31m╚═════╝  ╚═════╝ ╚═════╝ ╚══════╝╚═╝  ╚═╝\x1b[0m                 \x1b[36m║\x1b[0m
\x1b[36m║\x1b[0m                                                              \x1b[36m║\x1b[0m
\x1b[36m║\x1b[0m  \x1b[33mUniversal Security Testing Framework v2.0.0\x1b[0m                  \x1b[36m║\x1b[0m
\x1b[36m║\x1b[0m  \x1b[90mNation-State Grade | Defense-in-Depth | Production Ready\x1b[0m  \x1b[36m║\x1b[0m
\x1b[36m╚══════════════════════════════════════════════════════════════╝\x1b[0m
`);

program
  .name('omnisectester')
  .description('Nation-state grade security testing framework')
  .version('2.0.0', '-v, --version');

// Global options
program
  .option('--verbose', 'Enable verbose logging')
  .option('--quiet', 'Suppress non-essential output')
  .option('--no-color', 'Disable colored output')
  .option('--config <path>', 'Path to configuration file', './omnisectester.yaml')
  .option('--output <dir>', 'Output directory for reports', './reports')
  .option('--authorization <ref>', 'Authorization document reference')
  .option('--kill-switch', 'Enable kill switch (emergency stop)');

// Engage command (full engagement)
program.addCommand(new EngageCommand(logger));

// Scan command (platform-specific)
const scanCommand = new ScanCommand(logger);
program.addCommand(scanCommand);

// Threat model command (Step 0 - mandatory)
program.addCommand(new ThreatModelCommand(logger));

// Red team command (full kill chain)
program.addCommand(new RedTeamCommand(logger));

// Report command (generate reports)
program.addCommand(new ReportCommand(logger));

// SBOM command (supply chain)
program.addCommand(new SbomCommand(logger));

// Continuous command (CI/CD integration)
program.addCommand(new ContinuousCommand(logger));

// List command (list available tests)
program.addCommand(new ListCommand(logger));

// Verify command (verify tool installation)
program.addCommand(new VerifyCommand(logger));

// Severity command (lookup severity for CVE)
program.addCommand(new SeverityCommand(logger));

// Parse arguments
program.parse(process.argv);

// Show help if no command provided
if (!process.argv.slice(2).length) {
  program.outputHelp();
}

// Handle uncaught errors
process.on('uncaughtException', (error) => {
  logger.error('Uncaught exception:', error);
  process.exit(1);
});

process.on('unhandledRejection', (reason, promise) => {
  logger.error('Unhandled rejection at:', promise, 'reason:', reason);
  process.exit(1);
});

